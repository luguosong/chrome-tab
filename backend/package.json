{
  "name": "chrome-tab-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --external:better-sqlite3 && esbuild src/etl.cli.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/etl.cjs --external:better-sqlite3",
    "start": "node --expose-gc dist/index.js",
    "etl": "tsx src/etl.cli.ts",
    "measure": "node scripts/measure-rss.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "chrome-tab-shared": "workspace:*",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.3",
    "kysely": "^0.29.5",
    "node-cron": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "mysql2": "^3.23.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
