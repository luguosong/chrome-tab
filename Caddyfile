# {$DOMAIN} 由 compose 注入环境变量。
# Caddy 自动签发并续期 Let's Encrypt 证书（需域名 A 记录指向本机、80/443 公网可达）。
{$DOMAIN} {
    # API 反代到后端容器
    handle /api/* {
        reverse_proxy backend:8080
    }

    # 前端静态托管（SPA fallback 到 index.html）
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
