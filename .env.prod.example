# 生产部署环境变量。复制为 .env.prod 填真实值（.env.prod 已被 .gitignore 排除）。
# 用法：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# 域名：Caddy 据此自动签 HTTPS 证书。需 A 记录指向 VPS 公网 IP，且 80/443 开放。
DOMAIN=newtab.example.com

# 后端管理员（仅空库首启 seed 生效；已有数据全跳过，改密走 SQLite UPDATE）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong

# 外部 API Key。注意：compose 必须有对应 ${} 透传行容器才拿得到——
# .env 有键、compose 无引用 = 容器拿不到值（已出过 weather 500 数月的事故）。
AIHUBMIX_API_KEY=
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 滴答清单「待办」的 API 口令:网页版「头像 → 设置 → 账户与安全 → API 口令」生成。
# 为空 = 待办图标显示未配置(其余功能不受影响)。
DIDA365_TOKEN=

# 服务器状态「服务器」卡片:servermon exporter 地址(含 token,机器各自生成,
# 见 thinkpad-ubuntu 仓库 scripts/servermon)。为空 = 卡片无数据(dev 不受影响)。
# SERVERMON_THINKPAD_URL=http://127.0.0.1:10001/status?token=<thinkpad-token>
# SERVERMON_ALIYUN_URL=http://host.docker.internal:7800/status?token=<aliyun-token>
SERVERMON_THINKPAD_URL=
SERVERMON_ALIYUN_URL=
