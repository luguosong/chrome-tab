# 后端管理员（首启建账户，ADMIN_PASSWORD 必填，缺则启动失败）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 数据库（开发复用本地 docker 中的 mysql 容器，例 uocs-mysql 暴露在 19002）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:19002/newtab?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<your-mysql-password>
